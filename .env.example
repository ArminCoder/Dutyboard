# Organisation shown in the UI. Defaults are fictional.
VITE_ORG_NAME="Ministarstvo unutrašnjih poslova · Demo kanton"
VITE_ORG_SHORT="MUP DK"
VITE_ORG_ROOT_NAME="MUP Demo kantona"
VITE_ORG_REGION="Demo kanton"
VITE_PRODUCT_NAME="Dutyboard"

# Server. Comma-separated label:key pairs for the access gate.
# A label with a profile in tenants.json (see tenants.example.json) gets that org's branding.
ACCESS_KEYS=demo:DEMO-2026
SESSION_SECRET=change-me-to-32-random-bytes
PORT=3000
TENANTS_FILE=./tenants.json
